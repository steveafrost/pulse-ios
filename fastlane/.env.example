# fastlane/.env.example - copy to fastlane/.env and fill in, or export in CI.
# `fastlane/.env` is gitignored. Never commit real values.
#
# All of these are optional on a machine where `asc auth list` shows an active
# account (this developer Mac). They exist so CI can authenticate without the
# developer's ~/.asc/credentials.json.
#
# App Store Connect API key. `asc auth login --key-id ... --issuer-id ... --key-path ...`
# reads the same three values.
ASC_KEY_ID=38R6G5B784
ASC_ISSUER_ID=4e8ddd0a-9e6c-4877-ae9d-3f7168c02256
# Path to the .p8 file. NEVER commit the file itself. In CI, write it from a secret.
ASC_KEY_PATH=/absolute/path/to/AuthKey_38R6G5B784.p8

# Numeric App Store Connect app id for com.steveafrost.pulse.
# Empty until the app record exists (App Store Connect -> My Apps -> + -> New App).
# The beta lane's upload step needs it; build_only does not.
PULSE_ASC_APP_ID=

# Team / seed id. Also in project.yml as DEVELOPMENT_TEAM.
PULSE_TEAM_ID=4QJ25Y85MX
